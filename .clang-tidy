---
# Disabled checks fight suckless style or are Annex K/C11-only advice:
#   assignment-in-if-condition: suckless writes "if (!(p = malloc(n)))"
#   braces-around-statements: suckless omits braces on single statements
#   easily-swappable-parameters: noise for (int, int) helpers
#   identifier-length: c, i, n are idiomatic in short C
#   insecureAPI.DeprecatedOrUnsafeBufferHandling: wants memset_s (Annex K)
#   isolate-declaration: suckless allows "int c, n;"
#   magic-numbers: puzzle constants; prefer #define where it adds meaning
# include-cleaner maps POSIX names (EINTR, sigset_t, ...) to glibc-private
# headers (asm-generic/, bits/) that must never be included directly.
# C's &&, ||, ! and ?: operate on int, so every C23 bool operand converts;
# the check models C++ and has no C option (clang-tidy 21).
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-assignment-in-if-condition,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-isolate-declaration,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
CheckOptions:
  misc-include-cleaner.IgnoreHeaders: '(asm-generic|bits)/.*'
